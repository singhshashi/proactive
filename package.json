{
  "name": "@singhshashi/proactive",
  "version": "0.13.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build-lib": "tsc -p tsconfig.lib.json",
    "prepare": "pnpm run build-lib || echo `Prepare script failed`",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "pnpm run test-storybook",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook:runner": "test-storybook --url http://127.0.0.1:6006",
    "test-storybook": "start-server-and-test \"storybook dev -p 6006 --ci --no-open\" http://127.0.0.1:6006 \"pnpm run test-storybook:runner\""
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "peerDependencies": {
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-links": "^10.4.0",
    "@storybook/addon-onboarding": "^10.4.0",
    "@storybook/react": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@storybook/test-runner": "^0.24.4",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.16",
    "clsx": "^2.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "eslint-plugin-storybook": "^10.4.0",
    "playwright": "^1.38.1",
    "postcss": "^8.4.30",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "start-server-and-test": "^3.0.5",
    "storybook": "^10.4.0",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^8.0.14"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.221",
    "lucide-react": "^0.511.0"
  }
}
